{
  // A clock, as a document.
  //
  // Everything here was Go a day ago: the sky, the ball's path, the lights,
  // the digits, the bar. None of it is now, which is the point -- a program
  // that wants this scene names this file.
  //
  // The minute is the period because the ball should come back to where it
  // started when the clock does. A ball on its own schedule drifts against
  // the time it is standing in front of, and it reads as two scenes.
  "name": "clock",
  "seconds": 60,

  "eye": { "at": { "y": 0.05 }, "lens": 1, "near": 0.05 },

  "shapes": [
    { "kind": "sky", "sun": true },

    // the lamp is always there; the sun is off at night, and an off light
    // costs the floor a shade everywhere, which is what night is
    { "kind": "light", "at": { "x": -1.2, "y": 3.0, "z": 1.6 } },
    { "kind": "light", "sun": true },

    { "kind": "floor",
      "y": -0.55, "tile": 0.62, "far": 9.5,
      "texture": { "kind": "checker", "a": "V", "b": "K", "u": 1, "v": 1 },
      "shade": { "V": "K", "K": "D", "D": "E" } },

    // the ball goes round once a minute and bounces four times as often.
    // the height is an absolute sine, so it arrives at the floor rather
    // than easing into it -- a bounce lands, it does not settle.
    { "kind": "sphere", "name": "ball",
      "radius": 0.34,
      "spin": { "x": 0.11, "y": 0.43, "z": 0.07 },
      "texture": { "kind": "quadrants" },
      "at": {
        "x": { "mid": 0, "amp": 1.3, "period": 60 },
        "y": { "add": [ -0.21, { "abs": { "mid": 0, "amp": 0.66, "period": 8 } } ] },
        "z": { "mid": 3.6, "amp": -0.7, "period": 60, "phase": 0.25 }
      } },

    // the day, as a cylinder lying on the floor. it fills from sunrise to
    // sunset and nothing sets it: @daylight is the hour, and the texture
    // reads it every frame.
    { "kind": "cylinder", "name": "daylight",
      "at": { "x": -0.1, "y": -0.48, "z": 2.5 },
      "radius": 0.07, "length": 2.0, "caps": true,
      "texture": {
        "kind": "split",
        "frac": "@daylight",
        "done": { "kind": "stripes", "a": "O", "b": "R", "period": 0.143 },
        "rest": { "kind": "stripes", "a": "D", "b": "K", "period": 0.143 }
      } },

    { "kind": "clock", "name": "face",
      "row": 2, "col": -1, "font": "small", "flicker": true, "scrim": 0.40,
      "ink": [ "ff2a9d", "c44fb0", "8a5ad8", "3f7ad6", "2de2e6" ] }
  ]
}
