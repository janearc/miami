# built things
/miami
/bin/
/sprites/bin/

# the sibling libraries, cloned by bootstrap.sh rather than vendored. they
# are other repositories and belong to themselves; go.work expects them here.
/libs/

# what the verbs write. every one of these is regenerated by a command in the
# readme, so none of it is lost by being absent -- and out/ alone is 36M.
/out/
/look/
/regress/
*.frames

# the source photographs. large, and not this repository's to redistribute:
# dist/ holds what was made from them. see README for where they live.
/sources/

# the python art pipeline's scratch. the .py files are kept, being still the
# only tracer there is until it moves to go; their output is not.
/dolphin/*.png
/dolphin/*.ansi
/dolphin/*.txt
/dolphin/__pycache__/

# mine, not miami's: the game config this agent runs with, and the caches
# go and staticcheck leave when they are run with this directory as HOME.
# a clone of miami by anybody else should not carry either.
/.config/
/go/
/Library/
