{
  // What game draws while it builds.
  //
  // The clock scene with one thing changed: the cylinder has a name and no
  // binding, so the program fills it instead of the hour.
  //
  // That is the whole difference between a scene that watches the sky and a
  // scene that watches a build.
  "name": "build",
  "seconds": 60,

  "eye": { "at": { "y": 0.05 }, "lens": 1, "near": 0.05 },

  "shapes": [
    { "kind": "sky", "sun": true },

    // the lamp is always there; the sun is off at night, and an off light
    // costs the floor a shade everywhere, which is what night is
    // high, and behind what it lights rather than in front of it. with
    // the lamp nearer the camera than the thing casting, every shadow
    // falls away from the viewer and hides behind its own object, which
    // is how a bar on a floor ends up looking painted on.
    { "kind": "light", "at": { "x": -1.4, "y": 3.2, "z": 5.2 } },
    { "kind": "light", "sun": true },

    { "kind": "floor",
      "y": -0.55, "tile": 0.62, "far": 9.5,
      "texture": { "kind": "checker", "a": "V", "b": "K", "u": 1, "v": 1 },
      "shade": { "V": "K", "K": "D", "D": "E" } },

    // the ball goes round once a minute and bounces four times as often.
    // the height is an absolute sine, so it arrives at the floor rather
    // than easing into it -- a bounce lands, it does not settle.
    { "kind": "sphere", "name": "ball",
      "radius": 0.28,
      "spin": { "x": 0.11, "y": 0.43, "z": 0.07 },
      "texture": { "kind": "quadrants" },
      "at": {
        "x": { "mid": 0, "amp": 1.3, "period": 60 },
        "y": { "add": [ -0.26, { "abs": { "mid": 0, "amp": 0.46, "period": 8 } } ] },
        "z": { "mid": 3.6, "amp": -0.7, "period": 60, "phase": 0.25 }
      } },

    // the work, as a cylinder lying on the floor. it has a name and no
    // frac, which is what makes it the program's: game sets it from
    // wherever the build has got to.
    { "kind": "cylinder", "name": "build",
      // off the floor rather than resting on it, so the lamp
      // overhead throws a shadow you can see. a bar sitting flat
      // has its shadow underneath itself and reads as a painted
      // stripe.
      "at": { "x": 0, "y": -0.36, "z": 2.35 },
      "radius": 0.08, "length": 1.7, "caps": true,
      // it turns, which is what makes stripes a barber's pole and
      // what says it is working when nothing has finished yet
      "spin": { "x": 0.35 },
      "texture": {
        "kind": "split",
        "done": { "kind": "stripes", "a": "O", "b": "R",
                  "period": 0.11, "duty": 0.5, "lean": 5 },
        "rest": { "kind": "stripes", "a": "D", "b": "K",
                  "period": 0.11, "duty": 0.5, "lean": 5 }
      } },

    // a palm tree, because this is a vaporwave scene and the system
    // already holds a drawing of one
    { "kind": "emoji", "name": "palm", "rune": "1F334",
      "cols": 12, "colours": 10, "row": -8, "col": 4 },

    { "kind": "clock", "name": "face",
      // auto: the largest face whose clock fits a third of the width,
      // because type is characters and does not scale with the window
      "row": 1, "col": -1, "font": "auto", "flicker": true, "scrim": 0.25,
      "ink": [ "ff2a9d", "c44fb0", "8a5ad8", "3f7ad6", "2de2e6" ] },

    // what the build is saying, in plain glyphs and wrapped. above the
    // bar rather than over it: output in front of a progress bar hides
    // the one thing the bar is for.
    // under the clock rather than above the bar. both are anchored to
    // the top, so they cannot walk into each other when the terminal
    // is a different height -- and the bar is placed in space, whose
    // screen row moves with the frame's shape.
    { "kind": "log", "name": "out",
      // no width and no height: it takes what the window has, so a
      // wide terminal gets a wide box rather than the same small one
      "row": 7, "col": 3, "scrim": 0.42,
      "ink": [ "8a5ad8", "3f7ad6", "2de2e6", "ff2a9d" ] }
  ]
}
