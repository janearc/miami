{
  // What game draws while it builds.
  //
  // The clock scene with one thing changed: the cylinder has a name and no
  // binding, so the program fills it instead of the hour.
  //
  // That is the whole difference between a scene that watches the sky and a
  // scene that watches a build.
  "name": "build",
  "seconds": 60,

  "eye": { "at": { "y": 0.05 }, "lens": 1, "near": 0.05 },

  "shapes": [
    { "kind": "sky", "sun": true },

    // the lamp is always there; the sun is off at night, and an off light
    // costs the floor a shade everywhere, which is what night is
    { "kind": "light", "at": { "x": -1.2, "y": 3.0, "z": 1.6 } },
    { "kind": "light", "sun": true },

    { "kind": "floor",
      "y": -0.55, "tile": 0.62, "far": 9.5,
      "texture": { "kind": "checker", "a": "V", "b": "K", "u": 1, "v": 1 },
      "shade": { "V": "K", "K": "D", "D": "E" } },

    // the ball goes round once a minute and bounces four times as often.
    // the height is an absolute sine, so it arrives at the floor rather
    // than easing into it -- a bounce lands, it does not settle.
    { "kind": "sphere", "name": "ball",
      "radius": 0.34,
      "spin": { "x": 0.11, "y": 0.43, "z": 0.07 },
      "texture": { "kind": "quadrants" },
      "at": {
        "x": { "mid": 0, "amp": 1.3, "period": 60 },
        "y": { "add": [ -0.21, { "abs": { "mid": 0, "amp": 0.66, "period": 8 } } ] },
        "z": { "mid": 3.6, "amp": -0.7, "period": 60, "phase": 0.25 }
      } },

    // the work, as a cylinder lying on the floor. it has a name and no
    // frac, which is what makes it the program's: game sets it from
    // wherever the build has got to.
    { "kind": "cylinder", "name": "build",
      "at": { "x": -0.1, "y": -0.495, "z": 2.9 },
      "radius": 0.055, "length": 2.0, "caps": true,
      "texture": {
        "kind": "split",
        "done": { "kind": "stripes", "a": "O", "b": "R", "period": 0.143 },
        "rest": { "kind": "stripes", "a": "D", "b": "K", "period": 0.143 }
      } },

    // a palm tree, because this is a vaporwave scene and the system
    // already holds a drawing of one
    { "kind": "emoji", "name": "palm", "rune": "1F334",
      "cols": 12, "colours": 10, "row": -8, "col": 4 },

    { "kind": "clock", "name": "face",
      "row": 1, "col": -1, "font": "mini", "flicker": true, "scrim": 0.25,
      "ink": [ "ff2a9d", "c44fb0", "8a5ad8", "3f7ad6", "2de2e6" ] },

    // what it is doing, which the program sets
    { "kind": "text", "name": "what", "text": "building",
      "row": -3, "col": 3, "font": "mini", "scrim": 0.30,
      "ink": [ "ff2a9d", "c44fb0", "8a5ad8", "3f7ad6", "2de2e6" ] }
  ]
}
